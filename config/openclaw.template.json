{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "userTimezone": "Asia/Shanghai"
    },
    "entries": {
      "main": {
        "default": true,
        "identity": {
          "name": "AgentDesk",
          "theme": "private local workbench compatible with WorkBuddy skills",
          "emoji": "AD"
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_SETUP_GENERATED_TOKEN"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://127.0.0.1:3080",
        "http://localhost:3080",
        "http://127.0.0.1:5173",
        "http://localhost:5173"
      ]
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "~/.workbuddy/skills"
      ],
      "watch": true
    },
    "install": {
      "nodeManager": "npm",
      "allowUploadedArchives": true
    }
  }
}
